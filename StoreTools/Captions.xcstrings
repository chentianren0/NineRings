{
  "sourceLanguage": "en",
  "strings": {
    "caption.halfFold": {
      "comment": "App Store picture caption, over the first picture on the half-folded iPhone Duo: the toy stands on the upper half, the controls lie on the lower half. One short line, a phrase rather than a sentence; keep it under about 30 characters.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half fold it and watch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliez à moitié, puis regardez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を半分に折って見る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 iPhone 半折起来看"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 iPhone 半摺起來看"
          }
        }
      }
    },
    "caption.lesson": {
      "comment": "App Store picture caption, over the lesson open beside the toy. The same words as the welcome page's \"Learn how it works\" (Screens catalog, welcome.learn.title); use the same translation. One short line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn how it works"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez le principe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しくみを知る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解原理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "了解原理"
          }
        }
      }
    },
    "caption.move": {
      "comment": "App Store picture caption, over the first picture: a ring part way through coming off the sword. The hero picture, seen first in search results. One short line, a phrase rather than a sentence; keep it under about 30 characters.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch every ring come off"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez chaque anneau sortir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輪が外れていく様子を、じっくり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看清每个环怎么取下"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看每個環怎麼取下來"
          }
        }
      }
    },
    "caption.rest": {
      "comment": "App Store picture caption, over the toy at rest with all nine rings on the sword. The one rule decides which ring may move. One short line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nine rings. One rule."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuf anneaux, une seule règle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "9つの輪、1つのルール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "九个环，一条规则"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "九個環，一條規則"
          }
        }
      }
    },
    "caption.solved": {
      "comment": "App Store picture caption, over the solved toy, every ring off, with the congratulation showing. One short line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take every ring off"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez tous les anneaux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての輪を外す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把环全部取下来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把九個環全部取下"
          }
        }
      }
    },
    "caption.view": {
      "comment": "App Store picture caption, over the toy seen at an angle from above, in dark appearance: the toy can be turned and seen from any side. One short line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look from any side"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous tous les angles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きな角度から見られる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从各个角度看"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從任何角度看"
          }
        }
      }
    },
    "caption.why": {
      "comment": "App Store picture caption, over a ring that was tapped and cannot move: the app says why and outlines the ring in the way. Close to the welcome page's \"See why\" (Screens catalog, welcome.why.title). One short line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See why a ring can’t move"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprenez pourquoi un anneau est bloqué"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輪が動かない理由がわかる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看懂这个环为什么动不了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看懂這個環為什麼動不了"
          }
        }
      }
    }
  },
  "version": "1.0"
}