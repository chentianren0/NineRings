// The CloudKit schema of Nine Rings, in CloudKit's schema language: the record types the app keeps in iCloud.
// docs/icloud-schema.md says how it is applied and what can never change once it is in production.
// CloudKit keeps no comments when the schema is applied.

DEFINE SCHEMA

    // The toy: one record, named "toy", in the app's zone of the private database.
    RECORD TYPE Toy (
        format          ENCRYPTED INT64,
        payload         ENCRYPTED BYTES
    );

    // A finished play: one record for each, named by the play's id, in the same zone.
    RECORD TYPE FinishedPlay (
        format          ENCRYPTED INT64,
        payload         ENCRYPTED BYTES
    );

    // CloudKit's own record type for users, in every container.
    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
