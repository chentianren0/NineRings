{
  "sourceLanguage": "en",
  "strings": {
    "%@×": {
      "comment": "The speed button's label: how many times the normal speed moves play at, such as 0.5×."
    },
    "All nine rings are on the sword. Click a ring to move it.": {
      "comment": "Status at the start, with every ring on, on the Mac. A ring is clicked in the 3D view or by its numbered button."
    },
    "All nine rings are on the sword. Tap a ring to move it.": {
      "comment": "Status at the start, with every ring on. A ring is tapped in the 3D view or by its numbered button."
    },
    "All rings are off. The puzzle is solved.": {
      "comment": "Status when every ring is off the sword."
    },
    "Click a ring to move it.": {
      "comment": "Status when nothing is moving, on the Mac. A ring is clicked in the 3D view or by its numbered button."
    },
    "From Above": {
      "comment": "View menu item: the toy seen from above."
    },
    "From the Side": {
      "comment": "View menu item: the toy seen from the side."
    },
    "From the Tip": {
      "comment": "View menu item: the toy seen end on, from the sword's tip."
    },
    "Haptics": {
      "comment": "Settings switch: whether the rings' moves are felt as taps on iPhone."
    },
    "Lesson": {
      "comment": "Toolbar button that shows or hides the lesson on how the puzzle works."
    },
    "Move ring %lld": {
      "comment": "Tooltip on a ring button. The variable is the ring's number."
    },
    "Nine Rings": {
      "comment": "The window's title."
    },
    "Off": {
      "comment": "Spoken value of a ring button: the ring is off and cannot move now."
    },
    "Off, can go on": {
      "comment": "Spoken value of a ring button: the ring is off and can go on now."
    },
    "On": {
      "comment": "Spoken value of a ring button: the ring is on and cannot move now."
    },
    "On, can come off": {
      "comment": "Spoken value of a ring button: the ring is on and can come off now."
    },
    "Pause": {
      "comment": "Button that stops the move part way."
    },
    "Paused: ring %lld coming off — %@": {
      "comment": "Status while a ring's move is stopped part way. The first variable is the ring's number, the second the name of the stage."
    },
    "Paused: ring %lld going on — %@": {
      "comment": "Status while a ring's move is stopped part way. The first variable is the ring's number, the second the name of the stage."
    },
    "Play": {
      "comment": "Button that plays the move on the slider."
    },
    "Progress": {
      "comment": "Spoken name of the slider that runs through the move."
    },
    "Put every ring back on": {
      "comment": "Tooltip on the Reset button."
    },
    "Puzzle": {
      "comment": "Tab with the toy."
    },
    "Reset": {
      "comment": "Toolbar button that puts every ring back on."
    },
    "Ring %lld": {
      "comment": "Spoken name of a ring button. The variable is the ring's number."
    },
    "Ring %lld can’t move while ring %lld is off: ring %lld’s rod runs through ring %lld, and that rod is out of the slot, so ring %lld can’t pass through the slot.": {
      "comment": "Why a ring cannot move. The first, fourth and fifth variables are the ring tapped; the second and third the ring just before it, which is off. A ring's rod is the wire that holds it; the slot is the gap between the sword's two rails."
    },
    "Ring %lld can’t move while ring %lld is on: ring %lld’s rod stands in the slot between ring %lld and the tip.": {
      "comment": "Why a ring cannot move. The first and fourth variables are the ring tapped; the second and third a ring before it (a lower number) that is on. A ring's rod is the wire that holds it; the slot is the gap between the sword's two rails; the tip is the sword's rounded end."
    },
    "Ring %lld comes off — %@": {
      "comment": "Status while a ring comes off. The first variable is the ring's number, the second the name of the stage the move is in."
    },
    "Ring %lld goes on — %@": {
      "comment": "Status while a ring goes on. The first variable is the ring's number, the second the name of the stage the move is in."
    },
    "Rings": {
      "comment": "Spoken name of the row of nine ring buttons."
    },
    "Settings": {
      "comment": "Tab with the app's settings."
    },
    "Show how the puzzle works": {
      "comment": "Tooltip on the Lesson button."
    },
    "Solve": {
      "comment": "Button that plays the moves left to take every ring off."
    },
    "Sounds": {
      "comment": "Settings switch: whether the toy makes sounds as its rings move."
    },
    "Speed": {
      "comment": "Menu of the speeds moves play at."
    },
    "Standard View": {
      "comment": "View menu item: back to the view the toy is first seen from."
    },
    "Tap a ring to move it.": {
      "comment": "Status when nothing is moving. A ring is tapped in the 3D view or by its numbered button."
    },
    "Undo": {
      "comment": "Button that takes back the last move."
    },
    "Undoing: ring %lld comes back off — %@": {
      "comment": "Status while undoing a move that put a ring on. The first variable is the ring's number, the second the name of the stage the move is in."
    },
    "Undoing: ring %lld goes back on — %@": {
      "comment": "Status while undoing a move that took a ring off. The first variable is the ring's number, the second the name of the stage the move is in."
    },
    "View": {
      "comment": "Toolbar menu of the places to see the toy from."
    },
    "can’t move while ring %lld is off": {
      "comment": "Spoken hint on a ring button that cannot move. The variable is the ring just before it, which is off."
    },
    "can’t move while ring %lld is on": {
      "comment": "Spoken hint on a ring button that cannot move. The variable is a ring before it (a lower number) that is on."
    }
  },
  "version": "1.0"
}
