  "strings" : {
    "%@×" : {
      "comment" : "A playing speed: how many times the normal pace, such as 0.5× or 2×.\nThe speed button's label: how many times the normal speed moves play at, such as 0.5×.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@×"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@×"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@×"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@×"
          }
        }
      }
    },
    "All nine rings are on the sword. Click a ring to move it." : {
      "comment" : "Status at the start, with every ring on, on the Mac. A ring is clicked in the 3D view or by its numbered button.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les neuf anneaux sont sur la navette. Cliquez sur un anneau pour le déplacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "9つの輪がすべて枠にかかっています。輪をクリックすると動かせます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "九个环都在框架上。点按一个环来移动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "九個環都在劍上。按一下環即可移動。"
          }
        }
      }
    },
    "All nine rings are on the sword. Tap a ring to move it." : {
      "comment" : "Status at the start, with every ring on. A ring is tapped in the 3D view or by its numbered button.",
