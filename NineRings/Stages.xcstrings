  "strings" : {
    "Back over the slot" : {
      "comment" : "The name of a stage of a ring's move, shown in the status line after the move, as in 'Ring 1 comes off — <stage>'. A short label. Ring 1 coming off: having passed the tip, ring 1 swings back so that it is above the slot, the gap between the sword's two rails.",
      "extractionState" : "manual",
      "localizations" : {
