        }
      }
    },
    "Over the tip" : {
      "comment" : "The name of a stage of a ring's move, shown in the status line after the move, as in 'Ring 1 comes off — <stage>'. A short label. Ring 1's move: ring 1 passes over the sword's tip, its rounded end. Coming off, the ring is lifted over the tip; going on, it comes back over it to its place.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over the tip"
          }
        }
      }
    },
