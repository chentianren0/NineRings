{
  "sourceLanguage" : "en",
  "strings" : {
    "Back over the slot" : {
      "comment" : "The name of a stage of a ring's move, shown in the status line after the move, as in 'Ring 1 comes off — <stage>'. A short label. Ring 1 coming off: having passed the tip, ring 1 swings back so that it is above the slot, the gap between the sword's two rails.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back over the slot"
          }
        }
      }
    },
    "Down through the slot" : {
      "comment" : "The name of a stage of a ring's move, shown in the status line after the move, as in 'Ring 3 comes off — <stage>'. A short label. Ring 1, or the second ring on the sword, coming off: the ring goes down through the slot, the gap between the sword's two rails, past the rod of the ring before it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down through the slot"
          }
        }
      }
    },
    "Flatten" : {
      "comment" : "The name of a stage of a ring's move, shown in the status line after the move, as in 'Ring 1 comes off — <stage>'. A short label. Ring 1 coming off, first stage: ring 1 swings up from leaning down toward the tip until it lies flat, while the sword slides a little toward the grip.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flatten"
          }
        }
      }
    },
    "Hang" : {
      "comment" : "The name of a stage of a ring's move, shown in the status line after the move, as in 'Ring 1 comes off — <stage>'. A short label. Ring 1 coming off, last stage: ring 1 comes to rest hanging below the sword, across it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang"
          }
        }
      }
    },
    "Lean" : {
      "comment" : "The name of a stage of a ring's move, shown in the status line after the move, as in 'Ring 1 goes on — <stage>'. A short label. Ring 1 going on, last stage: ring 1 settles back on the sword, leaning down toward the tip as it rests.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean"
          }
        }
      }
    },
    "Lift" : {
      "comment" : "The name of a stage of a ring's move, shown in the status line after the move, as in 'Ring 1 goes on — <stage>'. A short label. Ring 1 going on, first stage: ring 1, hanging below the sword, lifts toward the slot.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lift"
          }
        }
      }
    },
    "Out past the tip" : {
      "comment" : "The name of a stage of a ring's move, shown in the status line after the move, as in 'Ring 1 goes on — <stage>'. A short label. Ring 1 going on: ring 1 moves out beyond the sword's tip, its rounded end, before coming back over it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Out past the tip"
