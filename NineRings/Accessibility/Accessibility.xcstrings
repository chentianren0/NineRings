    "ring.inTheWay %lld" : {
      "comment" : "Spoken on a ring button, after whether the ring is on: this ring is what stops the ring just asked for from moving. The variable is the number of the ring asked for.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "in the way of ring %lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "bloque l’anneau %lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "第%lld輪のじゃまをしている"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "挡着第%lld环"
