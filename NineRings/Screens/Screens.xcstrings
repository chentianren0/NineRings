    "history.clear.everyDevice" : {
      "comment" : "The message of the confirmation that comes before the history is cleared, when clearing also deletes the finished plays on the person's other devices, as when the plays are kept in iCloud.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every finished play will be deleted from all your devices. You can’t undo this action."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toutes les parties terminées seront supprimées de tous vos appareils. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "完了したプレイがすべてのデバイスから削除されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所有完成记录都将从你的所有设备上删除。此操作无法撤销。"
