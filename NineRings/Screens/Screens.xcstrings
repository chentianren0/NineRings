    "history.play.spoken %@ %@ %@ %@ %@" : {
      "comment" : "What VoiceOver reads for a finished play in the history, as one sentence. The first variable is when the play was finished, such as November 18, 2026 at 3:41 PM; the second its moves, such as 341 moves; the third the time spent, such as 20 minutes, 35 seconds; the fourth its undos, such as 4 undos; the fifth the moves the app played for the person, such as 60 moves played for you. Each variable comes already translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finished %1$@: %2$@ in %3$@, with %4$@ and %5$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Partie terminée le %1$@ : %2$@ en %3$@, avec %4$@ et %5$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@に完了。%3$@で%2$@、%4$@、%5$@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@完成：%2$@，用时%3$@，%4$@，%5$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@完成：%2$@，花了%3$@，%4$@，%5$@。"
          }
        }
      }
    },
    "history.play.spoken.shortestWay %@ %@ %@ %@ %@" : {
      "comment" : "What VoiceOver reads for a finished play in the history that went the shortest way, as one sentence: the same as the sentence for any play, saying the shortest way too. The first variable is when the play was finished, such as November 18, 2026 at 3:41 PM; the second its moves, such as 341 moves; the third the time spent, such as 9 minutes; the fourth its undos, 0 undos; the fifth the moves the app played for the person, 0 moves played for you. Each variable comes already translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finished %1$@, the shortest way: %2$@ in %3$@, with %4$@ and %5$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Partie terminée le %1$@ par le plus court chemin : %2$@ en %3$@, avec %4$@ et %5$@."
