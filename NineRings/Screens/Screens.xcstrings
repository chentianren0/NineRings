            "value" : "%1$@に最短手順で完了。%3$@で%2$@、%4$@、%5$@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@以最短路线完成：%2$@，用时%3$@，%4$@，%5$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@以最短路線完成：%2$@，花了%3$@，%4$@，%5$@。"
          }
        }
      }
    },
    "history.playedForYou %lld" : {
      "comment" : "In the history, how many of a finished play's moves the app made for the person: the moves Solve and the lesson played on their toy, such as 60 moves played for you. Shown in a line with the moves and the time spent, and inside the sentence VoiceOver reads for the play.",
